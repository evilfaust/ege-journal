# Синхронизация результатов в облачную Lemma (scripts/sync-to-lemma.mjs).
# Скопируй в .env.lemma и заполни. Запуск:
#   node --env-file=.env.lemma scripts/sync-to-lemma.mjs          # dry-run
#   node --env-file=.env.lemma scripts/sync-to-lemma.mjs --push   # заливка

LEMMA_PB_URL=https://task-ege.oipav.ru

# Отдельный учитель в Lemma (role=editor), созданный для синхронизации.
# Создать: Lemma → Администрирование → Пользователи → новый (role=editor).
LEMMA_SYNC_USER=journal-sync
# ⚠️ Если в пароле есть # — ОБЯЗАТЕЛЬНО в кавычках, иначе node --env-file
# обрежет значение по # (трактует как комментарий). Пример: LEMMA_SYNC_PASS="pa$$w0rd#"
LEMMA_SYNC_PASS=replace_me

# ID основного учителя (чьи это данные в журнале Lemma). Найти в Lemma →
# Администрирование → Пользователи (или в PB Admin → teachers). Если не задать —
# владельцем станет сам sync-аккаунт (пока owner-фильтрация выключена — не критично).
LEMMA_OWNER_ID=

# Локальный PocketBase журнала (по умолчанию http://127.0.0.1:8090)
LOCAL_PB_URL=http://127.0.0.1:8090
